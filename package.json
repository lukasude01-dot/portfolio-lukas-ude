{
    "name": "lukas-ude-portfolio",
    "version": "1.0.0",
    "private": true,
    "description": "Portfolio and business website of Lukas Ude. Frontend (static site) and backend (contact API) are deployable independently.",
    "type": "module",
    "engines": {
        "node": ">=22.9"
    },
    "scripts": {
        "setup": "npm --prefix frontend install",
        "dev": "node scripts/dev.js",
        "build": "npm --prefix frontend run build",
        "start": "npm --prefix backend start",
        "test": "npm --prefix backend test",
        "check": "node scripts/check-site.js"
    }
}

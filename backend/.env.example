# ==========================================================
# BACKEND ENVIRONMENT VARIABLES  (example – NO real values)
#
# HOW TO USE:
# 1. Copy this file to  backend/.env
# 2. Fill in your values.
# 3. NEVER commit backend/.env (it is in .gitignore).
#
# On a hosting provider, enter the same names + values in its
# dashboard ("Environment variables") instead of using a file.
# ==========================================================


# --- SERVER ---------------------------------------------------

# "development" locally, "production" on the live server.
NODE_ENV=development

# Port of the server (http://localhost:3000)
PORT=3000

# Network interface. 0.0.0.0 = reachable (needed on most hosts).
HOST=0.0.0.0

# Set to true when the server runs behind a proxy / load balancer
# (Hostinger, Nginx ...) so the real visitor IP is used.
# A number means that many proxies in front of the server.
TRUST_PROXY=false


# --- WEBSITE --------------------------------------------------

# true  = this server also delivers the built website (frontend/dist)
# false = API only (website hosted elsewhere, e.g. Netlify)
SERVE_FRONTEND=true

# Where the built website is (relative to /backend)
FRONTEND_DIST=../frontend/dist

# Websites that may send the contact form (comma separated).
# Must contain your real domain in production, e.g.
# ALLOWED_ORIGINS=https://lukasude.de,https://www.lukasude.de
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# --- SPAM PROTECTION ------------------------------------------

# Secret used to sign form tokens. REQUIRED in production.
# Create one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORM_TOKEN_SECRET=

# A message is rejected if sent faster than this (bots are instant)
FORM_MIN_SECONDS=3

# Max messages per visitor (IP) per time window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=15


# --- CONTACT FORM DELIVERY ------------------------------------

# log     = development: only prints to the console, sends nothing
# smtp    = e-mail through the mailbox of your own domain (free,
#           included with most domain packages)
# webhook = POST to Make / n8n / Zapier / CRM
CONTACT_DELIVERY=log

# For "smtp": the login data of your domain mailbox.
# You find them in your provider's help pages ("SMTP-Server"):
#   Hostinger: smtp.hostinger.com  port 465   (used for kontakt@lukasude.de)
#   IONOS:    smtp.ionos.de        port 465
#   Strato:   smtp.strato.de       port 465
#   All-Inkl: (see KAS, e.g. w0123456.kasserver.com) port 465
# Port 465 = encrypted from the start (recommended), 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Where contact messages are delivered (can be the same mailbox).
CONTACT_TO_EMAIL=
# Sender address. Leave empty to use SMTP_USER (recommended).
CONTACT_FROM_EMAIL=

# For "webhook":
CONTACT_WEBHOOK_URL=
# Optional: receiver can verify the X-Signature-SHA256 header
CONTACT_WEBHOOK_SECRET=
